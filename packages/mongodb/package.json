    "access control",
    "authorization",
    "multi-tenant",
    "tool use",
    "typescript"
  ],
  "author": "Nicolò D'Addabbo <nicolodaddabbo@gmail.com> (https://nicolod.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
